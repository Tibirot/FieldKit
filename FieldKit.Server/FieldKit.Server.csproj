<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.StackExchange.Redis.OutputCaching" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Security: override the vulnerable Microsoft.OpenApi 2.0.0 that AspNetCore.OpenApi 10.0.x
         still pins. GHSA-v5pm-xwqc-g5wc (circular-ref parser DoS) is fixed in 2.7.5 — the minimal
         patched version in the 2.x line. -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldKit.Web\FieldKit.Web.csproj" />
    <ProjectReference Include="..\FieldKit.Modules.Products\FieldKit.Modules.Products.csproj" />
    <ProjectReference Include="..\FieldKit.Infrastructure\FieldKit.Infrastructure.csproj" />
    <ProjectReference Include="..\FieldKit.Modules.Iam\FieldKit.Modules.Iam.csproj" />
    <ProjectReference Include="..\FieldKit.Modules.Org\FieldKit.Modules.Org.csproj" />
    <ProjectReference Include="..\FieldKit.Modules.Outlets\FieldKit.Modules.Outlets.csproj" />
    <ProjectReference Include="..\FieldKit.Modules.Configuration\FieldKit.Modules.Configuration.csproj" />
  </ItemGroup>
</Project>
