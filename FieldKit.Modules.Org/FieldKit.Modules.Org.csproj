<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Single assembly for now, deliberately. The registry pairs each module with a `.Contracts`
    assembly, and Organization will get one — but its public surface (`IOrgHierarchy`,
    `ITerritoryDirectory`, `IRepScope`) all describe things that do not exist yet: the management
    line needs positions, and territories need outlets. An interface designed before its consumer is
    a guess that other modules then have to live with, so it lands with the slice that needs it.
  -->

  <ItemGroup>
    <ProjectReference Include="..\FieldKit.SharedKernel\FieldKit.SharedKernel.csproj" />
    <ProjectReference Include="..\FieldKit.BuildingBlocks\FieldKit.BuildingBlocks.csproj" />
    <ProjectReference Include="..\FieldKit.Infrastructure\FieldKit.Infrastructure.csproj" />
    <ProjectReference Include="..\FieldKit.Web\FieldKit.Web.csproj" />
    <!--
      IAM's *contracts*, never its implementation (AT-1). A position names a user, so this module has
      to be able to ask whether that user exists — and asking through IUserDirectory rather than
      reading `iam.user` is what makes schema-per-module (ADR-0005) hold when a feature spans two
      modules. The architecture test checks the reference itself, not the intent.
    -->
    <ProjectReference Include="..\FieldKit.Modules.Iam.Contracts\FieldKit.Modules.Iam.Contracts.csproj" />
    <!--
      Outlets' contracts, for the same reason: a territory is defined by the outlets in it, so this
      module must be able to ask which ones exist and what they are called without reading the
      outlets schema. Contracts only, never the implementation (AT-1).
    -->
    <ProjectReference Include="..\FieldKit.Modules.Outlets.Contracts\FieldKit.Modules.Outlets.Contracts.csproj" />
    <ProjectReference Include="..\FieldKit.Modules.Org.Contracts\FieldKit.Modules.Org.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
