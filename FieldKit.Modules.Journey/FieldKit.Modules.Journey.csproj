<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FieldKit.SharedKernel\FieldKit.SharedKernel.csproj" />
    <ProjectReference Include="..\FieldKit.BuildingBlocks\FieldKit.BuildingBlocks.csproj" />
    <ProjectReference Include="..\FieldKit.Infrastructure\FieldKit.Infrastructure.csproj" />
    <ProjectReference Include="..\FieldKit.Web\FieldKit.Web.csproj" />
    <!--
      Contracts only, never the implementation (AT-1). Journey needs an outlet's segment to derive
      its call frequency (JRN-01) and its existence to refuse a rule about a shop this tenant does
      not have; it knows nothing about how Outlets stores either.
    -->
    <ProjectReference Include="..\FieldKit.Modules.Outlets.Contracts\FieldKit.Modules.Outlets.Contracts.csproj" />
    <!--
      Likewise. A working calendar names a rep, and only IAM knows whether this tenant has them —
      the same check a rep assignment makes, and for the same reason: a user id is a bare string.
    -->
    <ProjectReference Include="..\FieldKit.Modules.Iam.Contracts\FieldKit.Modules.Iam.Contracts.csproj" />
    <!--
      And Organization, for which outlets a rep covers — `IRepScope`, built in W7 slice 0 against
      this module as its only caller. BR-JRN-1 plans for the rep's active territory, and only
      Organization knows what that is.
    -->
    <ProjectReference Include="..\FieldKit.Modules.Org.Contracts\FieldKit.Modules.Org.Contracts.csproj" />
  </ItemGroup>

  <!--
    No `.Contracts` assembly yet, deliberately, and the same call Organization and Products made
    before it: `IJourneyQuery` is specified and has no consumer until Visit exists, so designing it
    now would be a guess Visit then has to live with. It arrives with the published plan (JRN-04).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
