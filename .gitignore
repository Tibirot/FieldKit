## FieldKit — .NET Aspire (C#) + Next.js/Vite frontend
## Never commit secrets. Lockfiles (package-lock.json / pnpm-lock.yaml) and appsettings.*.json
## ARE meant to be committed; local overrides and .env files are ignored below.

# ─────────────────────────────── .NET / build output ───────────────────────────────
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ll]og/
[Ll]ogs/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
build/
bld/
artifacts/
publish/
*.dll
*.exe
*.pdb
*.cache
project.lock.json
project.fragment.lock.json
*.nupkg
*.snupkg
.packages/
msbuild.log
msbuild.err
msbuild.wrn

# ─────────────────────────────── Test / coverage ───────────────────────────────
[Tt]est[Rr]esults/
TestResults/
coverage/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
.coverage
BenchmarkDotNet.Artifacts/

# ─────────────────────────────── Visual Studio / Rider / VS Code ───────────────────────────────
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates
*.userprefs
*.DotSettings.user
.idea/
_ReSharper*/
*.[Rr]e[Ss]harper
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# ─────────────────────────────── .NET tooling / secrets ───────────────────────────────
# User Secrets live outside the repo (managed by dotnet user-secrets) — nothing to ignore here,
# but never commit local secret overrides:
appsettings.*.local.json
**/secrets.json
*.pfx
*.p12
*.key
# Aspire generated manifest (deploy artifact)
aspire-manifest.json
.aspire/

# ─────────────────────────────── Node / Next.js / Vite (frontend) ───────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# Next.js
.next/
out/
next-env.d.ts

# Vite / bundler output
dist/
dist-ssr/
.vite/
.turbo/

# Build & TS incremental info
*.tsbuildinfo

# Frontend test / e2e artifacts
/playwright-report/
/playwright/.cache/
/test-results/
.nyc_output/

# Lint / tool caches
.eslintcache
.stylelintcache

# npm / yarn / pnpm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# ─────────────────────────────── Environment / local overrides ───────────────────────────────
.env
.env.*
!.env.example
!.env.sample
# Vite local env convention (e.g. .env.production.local)
*.local

# ─────────────────────────────── PWA / service worker generated ───────────────────────────────
**/public/sw.js
**/public/workbox-*.js
**/public/worker-*.js
**/public/sw.js.map

# ─────────────────────────────── OS / editor cruft ───────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─────────────────────────────── Misc ───────────────────────────────
*.log
*.tmp
*.bak
*.orig
