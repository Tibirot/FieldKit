<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FieldKit.SharedKernel\FieldKit.SharedKernel.csproj" />
    <ProjectReference Include="..\FieldKit.BuildingBlocks\FieldKit.BuildingBlocks.csproj" />
    <ProjectReference Include="..\FieldKit.Infrastructure\FieldKit.Infrastructure.csproj" />
    <ProjectReference Include="..\FieldKit.Web\FieldKit.Web.csproj" />
    <!--
      Contracts only, never the implementation (AT-1).

      Outlets says where the shop is and whether it exists; Configuration says how a visit is worked
      in that shop's channel and whether presence is expected there. Between them they are every
      input BR-VIS-2 needs, and Visit owns none of them.
    -->
    <ProjectReference Include="..\FieldKit.Modules.Outlets.Contracts\FieldKit.Modules.Outlets.Contracts.csproj" />
    <ProjectReference Include="..\FieldKit.Modules.Configuration.Contracts\FieldKit.Modules.Configuration.Contracts.csproj" />

    <!--
      And Journey, to check that a visit claiming to fulfil a planned call is claiming one that
      exists, belongs to this rep and is at this shop — the id was taken on trust until W7 slice 9b.
    -->
    <ProjectReference Include="..\FieldKit.Modules.Journey.Contracts\FieldKit.Modules.Journey.Contracts.csproj" />
  </ItemGroup>

  <!--
    No `.Contracts` assembly, deliberately — the call the delivery plan makes explicitly. Visit's own
    contracts (`IVisitContext`, `IVisitQuery`) are consumed by Audit and Order, which are Phase 3, and
    an interface designed before its consumer is a guess that consumer has to live with.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
