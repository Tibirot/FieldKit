<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Single assembly for now, for the same reason Organization is: every contract in this module's
    registry row — IOutletCatalog, IOutletClassification, IReferenceChangeFeed,
    IOutletProposalIngest — is shaped by a consumer that does not exist yet. Assortment keys off
    channel, Sync composes the change feed, the review queue receives proposals. Each lands with the
    slice that gives it a consumer, so the signature is designed rather than guessed.
  -->

  <ItemGroup>
    <ProjectReference Include="..\FieldKit.SharedKernel\FieldKit.SharedKernel.csproj" />
    <ProjectReference Include="..\FieldKit.BuildingBlocks\FieldKit.BuildingBlocks.csproj" />
    <ProjectReference Include="..\FieldKit.Infrastructure\FieldKit.Infrastructure.csproj" />
    <ProjectReference Include="..\FieldKit.Web\FieldKit.Web.csproj" />
    <ProjectReference Include="..\FieldKit.Modules.Outlets.Contracts\FieldKit.Modules.Outlets.Contracts.csproj" />
    <!--
      Configuration's contracts: an outlet's custom fields are validated against the tenant's
      catalogue (CFG-02), and asking through IFieldDefinitionCatalog rather than reading the config
      schema is what keeps ADR-0005 intact. Contracts only, never the implementation (AT-1).
    -->
    <ProjectReference Include="..\FieldKit.Modules.Configuration.Contracts\FieldKit.Modules.Configuration.Contracts.csproj" />
    <!--
      Organization's contracts: BR-OUT-1 says an outlet has a territory, and Organization owns the
      answer (ORG-05). This makes Org and Outlets the first pair of modules to reference each other's
      contracts — see Territory.cs for why that cannot cycle at build time, and AT-10 for the part
      that could cycle at runtime and is therefore tested rather than trusted.
    -->
    <ProjectReference Include="..\FieldKit.Modules.Org.Contracts\FieldKit.Modules.Org.Contracts.csproj" />
    <!--
      IAM's contracts: the outlet status trail records who made each transition as a Keycloak
      subject, and `IUserDirectory` is how that becomes a name without reading IAM's tables
      (ADR-0005). Consumed only from an endpoint, never from a contract implementation — AT-10
      constrains the latter because it is the re-enterable surface, and nothing calls back into an
      endpoint.
    -->
    <ProjectReference Include="..\FieldKit.Modules.Iam.Contracts\FieldKit.Modules.Iam.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bulk import (OUT-05) — see Directory.Packages.props for why it is not hand-rolled. -->
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
