<Project Sdk="Aspire.AppHost.Sdk/13.2.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>8a1fc797-b731-4be3-8c75-e8133bc5ca1d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldKit.Server\FieldKit.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Security pin over Aspire's vulnerable transitive MessagePack; rationale and removal
         condition live with the version in Directory.Packages.props. -->
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>
</Project>
