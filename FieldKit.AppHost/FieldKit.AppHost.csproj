<Project Sdk="Aspire.AppHost.Sdk/13.2.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>8a1fc797-b731-4be3-8c75-e8133bc5ca1d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldKit.Server\FieldKit.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Security: override the vulnerable MessagePack 2.5.192 pulled transitively by Aspire
         (GHSA-hv8m-jj95-wg3x + others). 2.5.302 is the latest patched 2.5.x (API-compatible). -->
    <PackageReference Include="MessagePack" Version="2.5.302" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.4.6" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.4.6" />
  </ItemGroup>
</Project>
