<!--
  The SDK version and the Aspire.Hosting.* package versions in Directory.Packages.props must move
  together. The SDK supplies DCP (the orchestrator), which refuses to start when it is older than
  the Aspire.Hosting packages it is asked to run — the app fails at launch with "Newer version of
  the Aspire.Hosting.AppHost package is required", *after* a clean build, so nothing catches it
  earlier. This version cannot live in Directory.Packages.props: central package management does
  not cover MSBuild SDK references.
-->
<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>8a1fc797-b731-4be3-8c75-e8133bc5ca1d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldKit.Server\FieldKit.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Security pin over Aspire's vulnerable transitive MessagePack; rationale and removal
         condition live with the version in Directory.Packages.props. -->
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>
</Project>
