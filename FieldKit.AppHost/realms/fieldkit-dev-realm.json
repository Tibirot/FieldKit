{
  "realm": "fieldkit-dev",
  "displayName": "FieldKit — dev tenant",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "product:read",
        "description": "Read products. Permission strings are resource:action per the IAM spec; modules check these, never role names (BR-IAM-2)."
      },
      {
        "name": "product:write",
        "description": "Create and modify products (Catalog module)."
      }
    ]
  },
  "clients": [
    {
      "clientId": "fieldkit-web",
      "name": "FieldKit web (Next.js)",
      "description": "Public OIDC client for the browser app. Authorization-code + PKCE, no client secret, per ADR-0008.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant",
            "claim.value": "00000000-0000-0000-0000-000000000001",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "permissions",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "fieldkit-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "rep",
      "email": "rep@fieldkit.local",
      "firstName": "Dev",
      "lastName": "Rep",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-not-a-secret",
          "temporary": false
        }
      ],
      "realmRoles": ["product:read", "product:write"]
    },
    {
      "username": "viewer",
      "email": "viewer@fieldkit.local",
      "firstName": "Dev",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-not-a-secret",
          "temporary": false
        }
      ],
      "realmRoles": ["product:read"]
    }
  ]
}
