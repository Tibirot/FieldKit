<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FieldKit.SharedKernel\FieldKit.SharedKernel.csproj" />
    <ProjectReference Include="..\FieldKit.BuildingBlocks\FieldKit.BuildingBlocks.csproj" />
    <ProjectReference Include="..\FieldKit.Infrastructure\FieldKit.Infrastructure.csproj" />
    <ProjectReference Include="..\FieldKit.Web\FieldKit.Web.csproj" />
    <!--
      Contracts only, never implementations (AT-1).

      Organization answers which outlets a rep covers (`IRepScope`); Outlets answers what changed
      among them (`IReferenceChangeFeed`). Sync owns neither question and reads neither schema — it
      asks, filters and pages.
    -->
    <ProjectReference Include="..\FieldKit.Modules.Org.Contracts\FieldKit.Modules.Org.Contracts.csproj" />
    <ProjectReference Include="..\FieldKit.Modules.Outlets.Contracts\FieldKit.Modules.Outlets.Contracts.csproj" />
    <!-- Journey answers what is on the rep's round; Sync pages it to the device (W8 slice 8a). -->
    <!-- Journey answers what is on the rep's round; Sync pages it to the device (W8 slice 8a). -->
    <ProjectReference Include="..\FieldKit.Modules.Journey.Contracts\FieldKit.Modules.Journey.Contracts.csproj" />
    <!-- Configuration owns the visit workflow; Sync pages it to the device (W8 slice 8b). -->
    <ProjectReference Include="..\FieldKit.Modules.Configuration.Contracts\FieldKit.Modules.Configuration.Contracts.csproj" />
    <!-- Products owns the catalogue; Sync pages it to the device (W8 slice 8c). -->
    <ProjectReference Include="..\FieldKit.Modules.Products.Contracts\FieldKit.Modules.Products.Contracts.csproj" />
    <!-- Visit owns what makes a visit valid; Sync applies pushed work through it, never by writing
         the visit schema (module boundaries §7). -->
    <ProjectReference Include="..\FieldKit.Modules.Visit.Contracts\FieldKit.Modules.Visit.Contracts.csproj" />
    <!-- And Audit owns what makes an audit valid and what it scores to (W10 slice 6). Sync holds no
         opinion about either: it routes the mutation and reports what came back. -->
    <ProjectReference Include="..\FieldKit.Modules.Audit.Contracts\FieldKit.Modules.Audit.Contracts.csproj" />
  </ItemGroup>

  <!--
    Still no `.Contracts` assembly of its own.

    The module registry lists `ISyncEndpoints` for Sync, and nothing outside this module calls it —
    pull and push are HTTP, spoken by a device rather than by another module. An interface exists
    when a caller asks for one.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
