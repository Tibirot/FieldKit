<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Configuration module (ADR-0009 §0). It owns every tenant definition: the field-definition
    catalogue now (CFG-01), and visit workflows, survey forms and score weights in Phase 3.
  -->

  <ItemGroup>
    <ProjectReference Include="..\FieldKit.SharedKernel\FieldKit.SharedKernel.csproj" />
    <ProjectReference Include="..\FieldKit.BuildingBlocks\FieldKit.BuildingBlocks.csproj" />
    <ProjectReference Include="..\FieldKit.Infrastructure\FieldKit.Infrastructure.csproj" />
    <ProjectReference Include="..\FieldKit.Web\FieldKit.Web.csproj" />
    <ProjectReference Include="..\FieldKit.Modules.Configuration.Contracts\FieldKit.Modules.Configuration.Contracts.csproj" />
    <!--
      Contracts only, never the implementation (AT-1). A visit workflow is keyed by channel, and only
      Outlets knows whether this tenant has that channel.

      This makes the two modules point at each other's contracts — Outlets already reads the
      custom-field catalogue from here — and that is explicitly the arrangement AT-1 permits: every
      `.Contracts` assembly is a leaf, so the assembly graph stays acyclic. What must not happen is a
      *runtime* cycle, and AT-10 is the test for it. There is none: `VisitWorkflowCatalog`, the class
      behind `IVisitWorkflow`, reads only this module's schema. The channel check lives in the
      endpoint, which is authoring rather than a contract anybody calls back through.
    -->
    <ProjectReference Include="..\FieldKit.Modules.Outlets.Contracts\FieldKit.Modules.Outlets.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
